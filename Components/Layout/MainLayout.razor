@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Typo="Typo.h6">TodoApp</MudLink>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3">
                    @context.User.Identity?.Name
                </MudText>
                <MudButton Href="/auth/logout" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small">
                    Sign Out
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="mr-2">
                    Guest Mode
                </MudChip>
                <MudButton Href="/auth/login/microsoft"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="mr-2 text-capitalize"
                           Style="background-color: #2F2F2F; color: #FFFFFF;"
                           StartIcon="@Icons.Custom.Brands.Microsoft">
                    Microsoft
                </MudButton>
                <MudButton Href="/auth/login/google"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="text-capitalize"
                           Style="background-color: #FFFFFF; color: #3c4043; border: 1px solid #dadce0;"
                           StartIcon="@Icons.Custom.Brands.Google">
                    Google
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>