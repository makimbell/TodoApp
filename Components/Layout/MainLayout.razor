@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Class="cursor-pointer" Style="cursor:pointer" Href="/">TodoApp</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3">
                    @context.User.Identity?.Name
                </MudText>
                <MudButton Href="/auth/logout" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small">
                    Sign Out
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="mr-2">
                    Guest Mode
                </MudChip>
                <MudButton Href="/auth/login/microsoft"
                           Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Custom.Brands.Microsoft">
                    Sign in with Microsoft
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>