@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Are you sure you want to permanently delete your account?
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">
            This will delete your user profile, all linked Microsoft/Google logins, and all of your todo lists and items. This cannot be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <form method="post" action="/auth/delete-account">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Error" Variant="Variant.Filled">
                Delete Account
            </MudButton>
        </form>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Cancel() => MudDialog.Cancel();
}

