@page "/lists/{Slug}"
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using TodoApp.Data
@using TodoApp.Models
@using TodoApp.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject TodoNotificationService Notifier

<PageTitle>@(currentList?.Title ?? "Todo List")</PageTitle>

@if (notFound)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4">
        List not found. <MudLink Href="/">Return to home</MudLink>
    </MudAlert>
}
else if (currentList is null)
{
    <div class="d-flex align-center gap-3 my-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        <MudText Typo="Typo.body2">Loading tasks...</MudText>
    </div>
}
else
{
    <MudPaper Elevation="3" Class="pa-6 rounded-lg">
        <div class="d-flex align-center gap-3 mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Default"
                           Class="flex-shrink-0"
                           OnClick="@(() => Nav.NavigateTo("/"))" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="wrap-anywhere">@currentList.Title</MudText>
        </div>

        <div class="d-flex align-start gap-3 mb-6">
            <MudTextField @bind-Value="newTitle"
                          Placeholder="New item"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          MaxLength="200"
                          Counter="200"
                          OnKeyUp="HandleKeyUp" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Style="height: 40px;"
                       OnClick="AddTodo"
                       Disabled="@string.IsNullOrWhiteSpace(newTitle)">
                Add
            </MudButton>
        </div>

        @if (!currentList.Items.Any())
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                No items in this list yet. Add a new task above!
            </MudAlert>
        }
        else
        {
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle2" Color="Color.Default" Style="opacity: 0.7;">
                    @currentList.Items.Count @(currentList.Items.Count == 1 ? "item" : "items")
                </MudText>
                <div style="width: 190px;">
                    <MudSelect T="TodoSortOption"
                               @bind-Value="sortOption"
                               Label="Sort by"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        <MudSelectItem Value="TodoSortOption.Created">Newest</MudSelectItem>
                        <MudSelectItem Value="TodoSortOption.DueDate">Due Date</MudSelectItem>
                        <MudSelectItem Value="TodoSortOption.Title">Title</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <MudList T="TodoItem" Dense="true" ReadOnly="false">
                @foreach (var item in GetSortedItems())
                {
                    <MudListItem T="TodoItem" Class="my-1 rounded mud-hover">
                        <ChildContent>
                            <div class="d-flex align-center justify-space-between gap-2 w-100">
                                <MudCheckBox T="bool"
                                             Value="@item.IsCompleted"
                                             ValueChanged="@((bool val) => ToggleItem(item, val))"
                                             Color="Color.Primary"
                                             Dense="true"
                                             Class="flex-shrink-0" />

                                <div class="flex-grow-1 py-1" style="min-width: 0; cursor: pointer;" @onclick="@(() => OpenItemDialog(item))">
                                    <MudText Class="wrap-anywhere" Style="@(item.IsCompleted ? "text-decoration: line-through; opacity: 0.6;" : "")">
                                        @item.Title
                                    </MudText>
                                </div>

                                <div class="flex-shrink-0 text-end" style="min-width: 95px; cursor: pointer;" @onclick="@(() => OpenItemDialog(item))">
                                    @if (item.DueDate.HasValue)
                                    {
                                        var isOverdue = !item.IsCompleted && item.DueDate.Value.Date < DateTime.Today;
                                        <MudText Typo="Typo.caption"
                                                 Color="@(isOverdue ? Color.Error : Color.Default)"
                                                 Style="@(isOverdue ? "" : item.IsCompleted ? "opacity: 0.6;" : "opacity: 0.7;")">
                                            @item.DueDate.Value.ToString("MMM d, yyyy")
                                        </MudText>
                                    }
                                </div>

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Class="flex-shrink-0"
                                               OnClick="@(() => DeleteItem(item.Id))" />
                            </div>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? currentUserId;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private TodoList? currentList;
    private bool notFound;
    private string newTitle = string.Empty;
    private TodoSortOption sortOption = TodoSortOption.Created;

    private enum TodoSortOption
    {
        Created,
        DueDate,
        Title
    }

    private IEnumerable<TodoItem> GetSortedItems()
    {
        if (currentList is null) return Enumerable.Empty<TodoItem>();

        return sortOption switch
        {
            TodoSortOption.DueDate => currentList.Items
                .OrderBy(t => t.IsCompleted)
                .ThenBy(t => t.DueDate is null)
                .ThenBy(t => t.DueDate)
                .ThenByDescending(t => t.CreatedAt),
            TodoSortOption.Title => currentList.Items
                .OrderBy(t => t.IsCompleted)
                .ThenBy(t => t.Title, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(t => t.CreatedAt),
            _ => currentList.Items
                .OrderBy(t => t.IsCompleted)
                .ThenByDescending(t => t.CreatedAt)
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        // Subscribe to real-time events from other clients
        Notifier.OnListsChanged += HandleListsUpdated;
        Notifier.OnListItemsChanged += HandleItemsUpdated;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadListDetails();
    }

    private async Task HandleItemsUpdated(int listId, string? ownerId)
    {
        if (ownerId != currentUserId) return;

        if (currentList is not null && currentList.Id == listId)
        {
            await InvokeAsync(async () =>
            {
                await LoadListDetails();
                StateHasChanged();
            });
        }
    }

    private async Task HandleListsUpdated(string? ownerId)
    {
        if (ownerId != currentUserId) return;

        // If the current list was deleted elsewhere, reload to trigger notFound state
        await InvokeAsync(async () =>
        {
            await LoadListDetails();
            StateHasChanged();
        });
    }

    private async Task LoadListDetails()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var list = await context.TodoLists
            .AsNoTracking()
            .Include(l => l.Items)
            .FirstOrDefaultAsync(l => l.Slug == Slug.ToLower());

        // Block access if the list belongs to someone else (or is private while user is guest)
        if (list is null || list.OwnerId != currentUserId)
        {
            currentList = null;
            notFound = true;
            return;
        }

        currentList = list;
        notFound = false;
    }

    private async Task OpenItemDialog(TodoItem item)
    {
        if (currentList is null) return;

        var parameters = new DialogParameters<TodoItemDialog>
        {
            { x => x.ItemId, item.Id },
            { x => x.ListId, currentList.Id },
            { x => x.OwnerId, currentUserId }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<TodoItemDialog>("Task Details", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadListDetails();
        }
    }

    private async Task AddTodo()
    {
        var trimmed = newTitle?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || currentList is null) return;

        if (trimmed.Length > 200)
        {
            Snackbar.Add("Task title must be 200 characters or fewer.", Severity.Warning);
            return;
        }

        var listId = currentList.Id;

        using var context = await DbFactory.CreateDbContextAsync();
        var item = new TodoItem
        {
            Title = trimmed,
            TodoListId = listId
        };

        context.TodoItems.Add(item);
        await context.SaveChangesAsync();

        newTitle = string.Empty;
        Snackbar.Add("Task added", Severity.Success);

        await LoadListDetails();
        await Notifier.NotifyListItemsChangedAsync(listId, currentUserId);
    }

    private async Task ToggleItem(TodoItem item, bool isCompleted)
    {
        if (currentList is null) return;
        var listId = currentList.Id;

        using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.TodoItems
            .FirstOrDefaultAsync(i => i.Id == item.Id && i.TodoListId == listId);

        if (existing is not null)
        {
            existing.IsCompleted = isCompleted;
            await context.SaveChangesAsync();
        }

        await LoadListDetails();
        await Notifier.NotifyListItemsChangedAsync(listId, currentUserId);
    }

    private async Task DeleteItem(int id)
    {
        if (currentList is null) return;
        var listId = currentList.Id;

        using var context = await DbFactory.CreateDbContextAsync();
        var item = await context.TodoItems
            .FirstOrDefaultAsync(i => i.Id == id && i.TodoListId == listId);

        if (item is not null)
        {
            context.TodoItems.Remove(item);
            await context.SaveChangesAsync();
            Snackbar.Add("Task removed", Severity.Normal);

            await LoadListDetails();
            await Notifier.NotifyListItemsChangedAsync(listId, currentUserId);
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTodo();
        }
    }

    public void Dispose()
    {
        // Unsubscribe from events to prevent memory leaks
        Notifier.OnListsChanged -= HandleListsUpdated;
        Notifier.OnListItemsChanged -= HandleItemsUpdated;
    }
}