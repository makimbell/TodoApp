@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using TodoApp.Data
@using TodoApp.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>Todo List</PageTitle>

<MudPaper Elevation="3" Class="pa-6 rounded-lg">
    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">My Tasks</MudText>

    <div class="d-flex align-center gap-3 mb-6">
        <MudTextField @bind-Value="newTitle"
                      Placeholder="What needs to be done?"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      MaxLength="100"
                      Clearable="true"
                      Immediate="true"
                      OnKeyUp="HandleKeyUp" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="AddTodo"
                   Disabled="@string.IsNullOrWhiteSpace(newTitle)">
            Add
        </MudButton>
    </div>

    @if (todos is null)
    {
        <div class="d-flex align-center gap-3 my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            <MudText Typo="Typo.body2">Waking up database...</MudText>
        </div>
    }
    else if (!todos.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text">
            No items yet. Add a new task above!
        </MudAlert>
    }
    else
    {
        <MudList T="TodoItem" Dense="true" ReadOnly="false">
            @foreach (var item in todos)
            {
                <MudListItem T="TodoItem" Class="my-1 rounded mud-hover">
                    <ChildContent>
                        <div class="d-flex align-center justify-space-between w-100">
                            <div class="d-flex align-center">
                                <MudCheckBox T="bool"
                                             Value="@item.IsCompleted"
                                             ValueChanged="@((bool val) => ToggleItem(item, val))"
                                             Color="Color.Primary"
                                             Dense="true" />
                                <MudText Style="@(item.IsCompleted ? "text-decoration: line-through; opacity: 0.6;" : "")">
                                    @item.Title
                                </MudText>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteItem(item.Id))" />
                        </div>
                    </ChildContent>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    private List<TodoItem>? todos;
    private string newTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        todos = await context.TodoItems
            .OrderBy(t => t.IsCompleted)
            .ThenByDescending(t => t.CreatedAt)
            .ToListAsync();
    }

    private async Task AddTodo()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        using var context = await DbFactory.CreateDbContextAsync();
        context.TodoItems.Add(new TodoItem { Title = newTitle.Trim() });
        await context.SaveChangesAsync();

        newTitle = string.Empty;
        Snackbar.Add("Task added", Severity.Success);
        await LoadTodos();
    }

    private async Task ToggleItem(TodoItem item, bool isCompleted)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        item.IsCompleted = isCompleted;
        context.TodoItems.Update(item);
        await context.SaveChangesAsync();
        await LoadTodos();
    }

    private async Task DeleteItem(int id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var item = await context.TodoItems.FindAsync(id);
        if (item is not null)
        {
            context.TodoItems.Remove(item);
            await context.SaveChangesAsync();
            Snackbar.Add("Task removed", Severity.Normal);
            await LoadTodos();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTodo();
        }
    }
}
