@page "/"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@using TodoApp.Data
@using TodoApp.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>My Todo Lists</PageTitle>

<MudPaper Elevation="3" Class="pa-6 rounded-lg">
    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">My Lists</MudText>

    <div class="d-flex align-center gap-3 mb-6">
        <MudTextField @bind-Value="newTitle"
                      Placeholder="New list name (e.g. Groceries, Chores)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      MaxLength="100"
                      Clearable="true"
                      Immediate="true"
                      MaxLength="100"
                      Counter="100"
                      OnKeyUp="HandleKeyUp" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="CreateList"
                   Disabled="@string.IsNullOrWhiteSpace(newTitle)">
            Add List
        </MudButton>
    </div>

    @if (lists is null)
    {
        <div class="d-flex align-center gap-3 my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            <MudText Typo="Typo.body2">Loading lists...</MudText>
        </div>
    }
    else if (!lists.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text">
            No lists yet. Create your first list above!
        </MudAlert>
    }
    else
    {
        <MudList T="TodoList" Dense="true" ReadOnly="false">
            @foreach (var item in lists)
            {
                <MudListItem T="TodoList" Class="my-1 rounded mud-hover">
                    <ChildContent>
                        <div class="d-flex align-center justify-space-between w-100">
                            <div class="d-flex align-center gap-3 cursor-pointer"
                                 style="cursor: pointer;"
                                 @onclick="@(() => Nav.NavigateTo($"/lists/{item.Slug}"))">
                                <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1">
                                    @item.Title
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                    @(item.Items.Count(i => !i.IsCompleted)) remaining
                                </MudChip>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteList(item.Id))" />
                        </div>
                    </ChildContent>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    private List<TodoList>? lists;
    private string newTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLists();
    }

    private async Task LoadLists()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        lists = await context.TodoLists
            .Include(l => l.Items)
            .OrderByDescending(l => l.CreatedAt)
            .ToListAsync();
    }

    private async Task CreateList()
    {
        var title = newTitle?.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        if (title.Length > 100)
        {
            Snackbar.Add("Title must be 100 characters or fewer.", Severity.Warning);
            return;
        }

        var baseSlug = GenerateSlug(title);
        if (string.IsNullOrWhiteSpace(baseSlug))
        {
            Snackbar.Add("Please enter a title with valid characters.", Severity.Warning);
            return;
        }

        using var context = await DbFactory.CreateDbContextAsync();

        // Ensure unique slug if duplicate names exist
        var slug = baseSlug;
        var counter = 1;
        while (await context.TodoLists.AnyAsync(l => l.Slug == slug))
        {
            slug = $"{baseSlug}-{counter++}";
        }

        var newList = new TodoList
        {
            Title = title,
            Slug = slug
        };

        context.TodoLists.Add(newList);
        await context.SaveChangesAsync();

        newTitle = string.Empty;
        Snackbar.Add($"Created list '{newList.Title}'", Severity.Success);
        await LoadLists();
    }

    private async Task DeleteList(int id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var item = await context.TodoLists.FindAsync(id);
        if (item is not null)
        {
            context.TodoLists.Remove(item);
            await context.SaveChangesAsync();
            Snackbar.Add("List deleted", Severity.Normal);
            await LoadLists();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateList();
        }
    }

    private static string GenerateSlug(string text)
    {
        var lower = text.ToLowerInvariant();
        // Replace invalid characters with hyphens
        var slug = Regex.Replace(lower, @"[^a-z0-9\s-]", "");
        // Convert whitespace to hyphens
        slug = Regex.Replace(slug, @"\s+", "-").Trim('-');
        return slug;
    }
}
